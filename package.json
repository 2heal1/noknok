{
  "name": "noknok-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm --filter @noknok/cli build && pnpm --filter @noknok/docs build",
    "build:cli": "pnpm --filter @noknok/cli build",
    "typecheck": "tsc --noEmit -p tsconfig.tools.json && pnpm --filter @noknok/cli typecheck && pnpm --filter @noknok/docs typecheck",
    "test": "pnpm --filter @noknok/cli test",
    "check": "pnpm check:secrets && pnpm build:cli && pnpm typecheck && pnpm test",
    "check:secrets": "node --import tsx scripts/check-secrets.ts",
    "check:package": "node --import tsx scripts/check-package.ts",
    "website": "pnpm --filter @noknok/docs dev",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "node --import tsx scripts/publish.ts",
    "demo": "node --import tsx scripts/demo.ts"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "tsx": "4.23.15"
  }
}
