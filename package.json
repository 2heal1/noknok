{
  "name": "@noknok/noknok",
  "version": "0.6.0",
  "description": "Lightweight, self-hosted meetings for native agents and people",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "noknok": "bin/noknok.mjs",
    "agentcall": "bin/agentcall.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2heal1/noknok.git"
  },
  "scripts": {
    "start": "node bin/noknok.mjs server",
    "start:local": "node bin/noknok.mjs local-server",
    "ui": "node bin/noknok.mjs ui",
    "test": "node --test test/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "poc:mcp-events": "node poc/mcp-events/server.mjs",
    "start:hosted": "node bin/noknok.mjs hosted-server",
    "check": "npm test",
    "check:package": "node scripts/check-package.mjs",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish"
  },
  "files": [
    "bin",
    "src",
    "web",
    "skills",
    "scripts/demo.mjs",
    "scripts/probe-mcp-events.mjs",
    "deploy",
    "poc/mcp-events",
    "README.md",
    "docs",
    "Dockerfile"
  ],
  "license": "UNLICENSED",
  "homepage": "https://github.com/2heal1/noknok#readme",
  "bugs": {
    "url": "https://github.com/2heal1/noknok/issues"
  },
  "packageManager": "npm@11.16.0",
  "devDependencies": {
    "@changesets/cli": "2.31.1"
  }
}
